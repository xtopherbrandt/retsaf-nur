  "decode": {
    "script": "decode_27_nights.py (session scratchpad, reproduced below)",
    "command": ".venv/Scripts/python.exe -I decode_27_nights.py <data dir>/captures/sprint-021-planning/hrv68-27-nights runcoach-api/tests/data/overnight-27-nights.csv",
    "decoder": "runcoach_api.ingestion.overnight.map_night -> fit_parser.decode (fitdecode)",
    "overnight_module_blob_sha": "f5d5d011108b2fca8324e6b0cba07996b489abf1",
    "tree": "5962bc07d964927878b6d2224d2fa26a76056803",
    "script_sha256": "932115715ca237583b9fd339d4605f65f46cca4efd255e88e0f944dfb6a86597",
    "script_text": [
      "\"\"\"Decode the 27 HRV_STATUS files into overnight-27-nights.csv.",
      "",
      "Usage: python decode_27_nights.py <source_dir> <out_csv>",
      "",
      "Each file goes through runcoach_api.ingestion.overnight.map_night (which decodes",
      "with fit_parser.decode, i.e. fitdecode). One row per Night:",
      "summary_timestamp_utc, series_start_utc, last_night_average_ms, hrv_values",
      "(hrv_values = the count of hrv_value messages stored). Prints, per file, the",
      "file id (the trailing number of the export's name), the Vancouver date of the",
      "summary timestamp, the average and the count, and refuses anything that is not",
      "a Night or any Vancouver date holding more than one night.",
      "\"\"\"",
      "",
      "from __future__ import annotations",
      "",
      "import csv",
      "import re",
      "import sys",
      "from collections import Counter",
      "from datetime import datetime",
      "from pathlib import Path",
      "from zoneinfo import ZoneInfo",
      "",
      "from runcoach_api.ingestion.overnight import Night, map_night",
      "",
      "VAN = ZoneInfo(\"America/Vancouver\")",
      "",
      "",
      "def main(src: str, out: str) -> None:",
      "    rows = []",
      "    ids = []",
      "    for path in sorted(Path(src).glob(\"*.fit\")):",
      "        file_id = re.search(r\"_(\\d+)\\.fit$\", path.name).group(1)",
      "        night = map_night(path.read_bytes())",
      "        assert isinstance(night, Night), (file_id, night)",
      "        s = night.session",
      "        local = datetime.fromisoformat(s.start_time).astimezone(VAN).date()",
      "        rows.append(",
      "            (s.start_time, s.summary[\"series_start\"], s.resting_rmssd_ms, s.summary[\"hrv_values\"], local, file_id)",
      "        )",
      "    rows.sort()",
      "    per_day = Counter(r[4] for r in rows)",
      "    assert all(c == 1 for c in per_day.values()), per_day",
      "    with open(out, \"w\", newline=\"\", encoding=\"utf-8\") as fh:",
      "        w = csv.writer(fh, lineterminator=\"\\n\")",
      "        w.writerow([\"summary_timestamp_utc\", \"series_start_utc\", \"last_night_average_ms\", \"hrv_values\"])",
      "        for start, series_start, avg, n, local, file_id in rows:",
      "            w.writerow([start, series_start, repr(float(avg)), n])",
      "            ids.append(file_id)",
      "            print(file_id, local, start, series_start, avg, n)",
      "    print(\"nights:\", len(rows), \"first:\", rows[0][4], \"last:\", rows[-1][4])",
      "    print(\"file_ids:\", \",\".join(ids))",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main(sys.argv[1], sys.argv[2])"
    ]
  }
